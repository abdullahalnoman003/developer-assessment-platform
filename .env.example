# ============================================
# CodeArena Backend — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your values.

# ── Database ──────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/codearena?schema=public"

# ── App Configuration ─────────────────────────
PORT=5000
APP_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
CANCEL_URL="http://localhost:3000"

# ── Authentication ────────────────────────────
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET="your_access_token_secret"
JWT_REFRESH_SECRET="your_refresh_token_secret"
# Signs the short-lived password-reset link. Falls back to JWT_ACCESS_SECRET when unset.
JWT_RESET_SECRET="your_reset_token_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# ── Password Reset Mail (SMTP) ─────────────────
# Leave SMTP_USER/SMTP_PASS empty to disable delivery. The reset link is then
# written to the backend console instead, so the flow still works in dev.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
# Gmail requires an App Password here, not the account password.
SMTP_PASS="your_smtp_app_password"
MAIL_FROM="CodeArena <your_email@gmail.com>"

# ── Demo Accounts (seeded on dev server boot — optional overrides) ──
DEMO_ADMIN_NAME="Demo Admin"
DEMO_ADMIN_EMAIL="admin@codearena.com"
DEMO_ADMIN_PASSWORD="admin1234"
DEMO_RECRUITER_NAME="Demo Recruiter"
DEMO_RECRUITER_EMAIL="recruiter@codearena.com"
DEMO_RECRUITER_PASSWORD="recruiter123"
DEMO_CANDIDATE_NAME="Demo Candidate"
DEMO_CANDIDATE_EMAIL="candidate@codearena.com"
DEMO_CANDIDATE_PASSWORD="candidate123"

# ── Payment Gateway (bKash / Stripe / SSLCommerz) ──
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"